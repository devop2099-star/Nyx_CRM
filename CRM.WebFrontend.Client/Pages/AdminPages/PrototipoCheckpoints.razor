    }

    private void AvanzarEtapa()
    {
        _bloqueoAvanceWarning = string.Empty;
        var v = CurrentVenta;
        if (v.StageIdx >= STAGES.Length - 1)
        {
            Snackbar.Add("La venta ya se encuentra en la etapa final (Postventa).", Severity.Info);
            return;
        }

        // Blindaje: Checkpoint pendiente con bloqueaAvance
        var bloqueante = v.Checkpoints.FirstOrDefault(cp => {
            if (cp.Estado != "PENDIENTE") return false;
            var def = _catalog.FirstOrDefault(c => c.Id == cp.CatalogId);
            return def != null && def.BloqueaAvance;
        });

        if (bloqueante != null)
        {
            var def = _catalog.First(c => c.Id == bloqueante.CatalogId);
            _bloqueoAvanceWarning = $"Avance bloqueado: El checkpoint '{def.Nombre}' está PENDIENTE y está configurado para impedir el avance. Resuélvelo primero.";
            Snackbar.Add("Avance bloqueado por checkpoint pendiente.", Severity.Warning);
            return;
        }

        v.StageIdx++;
        v.DayCounter++;
        var nuevaEtapa = STAGES[v.StageIdx];
        v.FechasPorEtapa[nuevaEtapa] = v.DayCounter;
        v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"Avanza a <b>{nuevaEtapa}</b>" });

        // Auto-disparo de checkpoints del catálogo
        var autoCheckpoints = _catalog.Where(c => c.Estado == "ACTIVO" && !c.DisparaSiKoDe.HasValue &&
            (c.Aplica == v.Campana || c.Aplica == "Toda campaña nueva" || v.Campana.StartsWith(c.Aplica)) &&
            c.Etapa == nuevaEtapa &&
            !v.Checkpoints.Any(cp => cp.CatalogId == c.Id)).ToList();

        foreach (var def in autoCheckpoints)
        {
            v.Checkpoints.Add(new CheckpointInstanceItem
            {
                CatalogId = def.Id,
                Estado = "PENDIENTE",
                FechaApertura = v.DayCounter,
                PasosCompletados = def.Pasos.Select(_ => false).ToList()
            });
            v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"Se abre checkpoint <b>{def.Nombre}</b> automáticamente (etapa disparo)" });
        }

        Snackbar.Add($"Venta avanzó a {nuevaEtapa}", Severity.Success);
    }

