        cp.Estado = "PENDIENTE";
        v.DayCounter++;
        v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"Checkpoint <b>{def?.Nombre}</b> reabierto — asesor corrigió, vuelve a revisión" });
        Snackbar.Add("Checkpoint reabierto para nueva revisión.", Severity.Info);
    }

    private void TogglePaso(int cpIdx, int pIdx)
    {
        var v = CurrentVenta;
        var cp = v.Checkpoints[cpIdx];
        var def = _catalog.FirstOrDefault(c => c.Id == cp.CatalogId);
        if (pIdx < cp.PasosCompletados.Count)
        {
            cp.PasosCompletados[pIdx] = !cp.PasosCompletados[pIdx];
            v.DayCounter++;
            var pasoName = def != null && pIdx < def.Pasos.Count ? def.Pasos[pIdx] : $"Paso #{pIdx + 1}";
            v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"Checkpoint <b>{def?.Nombre}</b> — paso \"{pasoName}\" marcado como {(cp.PasosCompletados[pIdx] ? "completado" : "pendiente")}" });
        }
    }

    private void AdjuntarCheckpointManual()
    {
        _retroWarning = string.Empty;
        var v = CurrentVenta;
        var def = _catalog.FirstOrDefault(c => c.Id == _selectedCheckpointToAttach);
        if (def == null) return;

        var etapaDisparoIdx = Array.IndexOf(STAGES, def.Etapa);
        var esRetro = v.StageIdx > etapaDisparoIdx;

        v.DayCounter++;
        v.Checkpoints.Add(new CheckpointInstanceItem
        {
            CatalogId = def.Id,
            Estado = "PENDIENTE",
            FechaApertura = v.DayCounter,
            Retro = esRetro,
            PasosCompletados = def.Pasos.Select(_ => false).ToList()
        });

        if (esRetro)
        {
            _retroWarning = $"Apertura retroactiva: La venta ya estaba en {STAGES[v.StageIdx]}, por delante de su etapa de disparo ({def.Etapa}). El aprovisionamiento externo no se detiene; solo se retienen los procesos derivados desde ahora.";
            v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"⚠ Checkpoint <b>{def.Nombre}</b> abierto <b>retroactivamente</b>" });
        }
        else
        {
            v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"Checkpoint <b>{def.Nombre}</b> adjuntado manualmente en {STAGES[v.StageIdx]}" });
        }

        Snackbar.Add(esRetro ? "Checkpoint abierto retroactivamente." : "Checkpoint adjuntado a la venta.", Severity.Info);
    }

    private void SimularCorteLiquidacion()
    {
        var v = CurrentVenta;
        v.DayCounter++;
        var corteDay = v.DayCounter;

        var bloqueantes = v.Checkpoints.Where(cp => cp.Estado == "PENDIENTE")
            .Select(cp => _catalog.FirstOrDefault(c => c.Id == cp.CatalogId))
            .Where(d => d != null && d.Bloquea.Contains("Liquidación")).ToList();

        if (bloqueantes.Any())
        {
            v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = $"💰 Corte de liquidación Proveedor➔GSI — <b>retenido</b> por checkpoint(s): {string.Join(", ", bloqueantes.Select(b => b!.Nombre))}" });
            Snackbar.Add("Liquidación retenida por checkpoints bloqueantes.", Severity.Warning);
            return;
        }

        var huboAccion = false;
        foreach (var it in v.Items)
        {
            if (it.Estado == "ACTIVO" && !it.FechaLiquidado.HasValue)
            {
                it.FechaLiquidado = corteDay;
                v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = $"💰 Liquidación Proveedor➔GSI: ítem <b>{it.Nombre}</b> liquidado" });
                huboAccion = true;
            }
            if (it.Estado == "DESCONECTADO" && it.FechaLiquidado.HasValue && !it.FechaDescuentoProveedor.HasValue)
            {
                it.FechaDescuentoProveedor = corteDay;
                v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = $"⚠ Proveedor descuenta a GSI por <b>{it.Nombre}</b> (desconexión)" });
                huboAccion = true;
            }
        }

        if (!huboAccion) v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = "Corte de liquidación ejecutado — sin partidas pendientes" });
        Snackbar.Add(huboAccion ? "Corte de liquidación ejecutado con éxito." : "Sin partidas pendientes de liquidar.", Severity.Info);
    }

    private void SimularPagoComercial()
    {
        var v = CurrentVenta;
        v.DayCounter++;
        var corteDay = v.DayCounter;

        var bloqueantes = v.Checkpoints.Where(cp => cp.Estado == "PENDIENTE")
            .Select(cp => _catalog.FirstOrDefault(c => c.Id == cp.CatalogId))
            .Where(d => d != null && d.Bloquea.Contains("Comisión")).ToList();

        if (bloqueantes.Any())
        {
            v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = $"💵 Corte de pago a comercial — <b>retenido</b> por checkpoint(s): {string.Join(", ", bloqueantes.Select(b => b!.Nombre))}" });
            Snackbar.Add("Pago a comercial retenido por checkpoints bloqueantes.", Severity.Warning);
            return;
        }

        var huboAccion = false;
        foreach (var it in v.Items)
        {
            if (it.FechaLiquidado.HasValue && !it.FechaPagoComercial.HasValue && it.Estado == "ACTIVO")
            {
                it.FechaPagoComercial = corteDay;
                var tarde = it.FechaLiquidado.Value < corteDay - 1;
                v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = $"💵 Comisión pagada a asesor por <b>{it.Nombre}</b>{(tarde ? " — <b>recálculo automático liberado</b>" : "")}" });
                huboAccion = true;
            }
            if (it.Estado == "DESCONECTADO" && it.FechaPagoComercial.HasValue && !it.FechaDescuentoComercial.HasValue)
            {
                it.FechaDescuentoComercial = corteDay;
                v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = $"⚠ GSI descuenta comisión a comercial por <b>{it.Nombre}</b> (descomisión)" });
                huboAccion = true;
            }
        }

        if (!huboAccion) v.Historial.Add(new SaleHistoryEventUiModel { Dia = corteDay, Detalle = "Corte de pago comercial ejecutado — sin comisiones pendientes" });
        Snackbar.Add(huboAccion ? "Corte de pago a comerciales ejecutado con éxito." : "Sin comisiones pendientes de pago.", Severity.Info);
    }

    private (string, string) GetEstadoPago(SaleItemUiModel it)
    {
        if (it.FechaDescuentoComercial.HasValue) return ("Descontado a asesor", "proto-pill-red");
        if (it.FechaDescuentoProveedor.HasValue && !it.FechaPagoComercial.HasValue) return ("Descontado a GSI — sin pagar a asesor", "proto-pill-red");
        if (it.FechaPagoComercial.HasValue) return ("Pagado al asesor", "proto-pill-green");
        if (it.FechaLiquidado.HasValue) return ("Liquidado a GSI — pendiente de pagar asesor", "proto-pill-amber");
        if (it.Estado == "DESCONECTADO") return ("Desconectado antes de liquidar — no se paga", "proto-pill-outline");
        if (it.Estado == "ACTIVO") return ("Activo — pendiente de liquidar con proveedor", "proto-pill-amber");
        return ("Sin activar", "proto-pill-outline");
    }
