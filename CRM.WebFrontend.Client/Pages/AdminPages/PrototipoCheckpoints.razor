@code {
    private static readonly string[] STAGES = new[] {
        "Preventa", "Venta Creada", "Gestión Inicial", "Validación Interna",
        "Envío Proveedor", "Validación Externa", "Firma", "Tramitación",
        "Activación", "Postventa"
    };

    private string _activeTab = "catalogo";
    private string _currentVentaId = "v1";
    private int _selectedCheckpointToAttach = 1;
    private string _bloqueoAvanceWarning = string.Empty;
    private string _retroWarning = string.Empty;

    // Helper property to access current sale cleanly
    private SaleUiModel CurrentVenta => _ventas.ContainsKey(_currentVentaId) ? _ventas[_currentVentaId] : _ventas.Values.First();
    private decimal TotalLiquidado => CurrentVenta.Items.Where(it => it.FechaLiquidado.HasValue).Sum(it => it.ValorLiquidacion);
    private decimal TotalPagado => CurrentVenta.Items.Where(it => it.FechaPagoComercial.HasValue && !it.FechaDescuentoComercial.HasValue).Sum(it => it.ComisionComercial);
    private decimal TotalDescontado => CurrentVenta.Items.Where(it => it.FechaDescuentoComercial.HasValue).Sum(it => it.ComisionComercial);

    private HashSet<string> GetPendingBlocks()
    {
        var blocks = new HashSet<string>();
        foreach (var cp in CurrentVenta.Checkpoints.Where(x => x.Estado == "PENDIENTE" || x.Estado == "KO"))
        {
            var def = _catalog.FirstOrDefault(c => c.Id == cp.CatalogId);
            if (def != null)
            {
                foreach (var b in def.Bloquea) blocks.Add(b);
            }
        }
        return blocks;
    }

    private List<string> GetRiesgos()
    {
        var riesgos = new List<string>();
        foreach (var cp in CurrentVenta.Checkpoints.Where(x => x.Estado == "KO"))
        {
            var def = _catalog.FirstOrDefault(c => c.Id == cp.CatalogId);
            if (def != null && !def.Bloquea.Any())
            {
                riesgos.Add(def.Nombre);
            }
        }
        return riesgos;
    }

    // Modales
    private bool _showNewCheckpointModal;
    private bool _showNewVentaModal;
    private bool _showNewItemModal;

    // Form Nuevo Checkpoint
    private string _newCpNombre = string.Empty;
    private string _newCpAplica = "Alarmas";
    private string _newCpEtapa = "Activación";
    private string _newCpOrigen = "INTERNO";
    private string _newCpAlcance = "Venta";
    private bool _newCpBloqueaComision = true;
    private bool _newCpBloqueaLiquidacion;
    private bool _newCpBloqueaAlta;
    private bool _newCpBloqueaAvance;
    private string _newCpRetrocedeA = string.Empty;
    private string _newCpDueno = "Finanzas";
    private bool _firmaDueno;
    private bool _firmaGerencia;
    private string _tempPasoText = string.Empty;
    private List<string> _newCpPasos = new();

    // Form Nueva Venta
    private string _newVentaNumero = string.Empty;
    private string _newVentaCampana = "Alarmas";

    // Form Nuevo Ítem
    private string _newItemNombre = string.Empty;
    private bool _newItemAncla;
    private bool _newItemNucleo = true;
    private string _newItemValorLiquidacion = "180";
    private string _newItemComisionComercial = "45";

    // Estado en memoria para interactividad total
    private List<CheckpointCatalogItem> _catalog = new()
    {
        new CheckpointCatalogItem { Id = 1, Nombre = "Auditoría de audio", Aplica = "Alarmas", Etapa = "Activación", Origen = "INTERNO", Alcance = "Venta", Bloquea = new() { "Comisión", "Alta del servicio" }, BloqueaAvance = false, Dueno = "Finanzas", Pasos = new() { "Sacar todos los audios de la llamada", "Identificar los tramos de sustento", "Editar y compilar audio", "Enviar sustento al proveedor", "Esperar respuesta" }, Estado = "ACTIVO" },
        new CheckpointCatalogItem { Id = 2, Nombre = "Revisión de supervisor", Aplica = "Toda campaña nueva", Etapa = "Gestión Inicial", Origen = "INTERNO", Alcance = "Venta", Bloquea = new(), BloqueaAvance = true, Dueno = "Operaciones", Pasos = new(), Estado = "ACTIVO" },
        new CheckpointCatalogItem { Id = 3, Nombre = "Confirmación de firma de contrato", Aplica = "Toda campaña nueva", Etapa = "Firma", Origen = "PROVEEDOR", Alcance = "Venta", Bloquea = new() { "Liquidación", "Comisión" }, BloqueaAvance = true, Dueno = "Backoffice", Pasos = new(), Estado = "ACTIVO" },
        new CheckpointCatalogItem { Id = 4, Nombre = "Seguimiento de satisfacción postventa", Aplica = "Toda campaña nueva", Etapa = "Postventa", Origen = "INTERNO", Alcance = "Venta", Bloquea = new(), BloqueaAvance = false, Dueno = "Postventa", Pasos = new() { "Llamar al cliente", "Confirmar satisfacción", "Identificar riesgo de baja" }, Estado = "ACTIVO" },
        new CheckpointCatalogItem { Id = 5, Nombre = "Validación de Backoffice", Aplica = "Toda campaña nueva", Etapa = "Validación Interna", Origen = "INTERNO", Alcance = "Venta", Bloquea = new(), BloqueaAvance = true, RetrocedeA = "Gestión Inicial", Dueno = "Backoffice", Pasos = new(), Estado = "ACTIVO" },
        new CheckpointCatalogItem { Id = 6, Nombre = "Validación de documentos externos", Aplica = "Toda campaña nueva", Etapa = "Validación Externa", Origen = "INTERNO", Alcance = "Venta", Bloquea = new(), BloqueaAvance = true, RetrocedeA = "Envío Proveedor", Dueno = "Backoffice", Pasos = new(), Estado = "ACTIVO" },
        new CheckpointCatalogItem { Id = 7, Nombre = "Gestión de recuperación", Aplica = "Toda campaña nueva", Etapa = "Postventa", Origen = "INTERNO", Alcance = "Venta", Bloquea = new() { "Comisión" }, BloqueaAvance = false, DisparaSiKoDe = 4, Dueno = "Postventa", Pasos = new() { "Contactar cliente en riesgo", "Ofrecer alternativa de retención" }, Estado = "ACTIVO" },
    };

    private Dictionary<string, SaleUiModel> _ventas = new()
    {
        ["v1"] = new SaleUiModel
        {
            Id = "v1", Label = "#4821 · Alarmas", Campana = "Alarmas", StageIdx = 8, DayCounter = 6,
            FechasPorEtapa = new() { ["Preventa"] = 1, ["Gestión Inicial"] = 3, ["Activación"] = 4 },
            Items = new()
            {
                new SaleItemUiModel { Nombre = "Producto principal (Alarma)", Ancla = true, Nucleo = true, Estado = "ACTIVO", FechaActivacion = 4, ValorLiquidacion = 280, ComisionComercial = 250 },
                new SaleItemUiModel { Nombre = "Cámara IP adicional", Ancla = false, Nucleo = false, Estado = "PENDIENTE", ValorLiquidacion = 60, ComisionComercial = 0 }
            },
            Checkpoints = new()
            {
                new CheckpointInstanceItem { CatalogId = 1, Estado = "PENDIENTE", FechaApertura = 4, Retro = false, PasosCompletados = new() { true, true, false, false, false } }
            },
            Historial = new()
            {
