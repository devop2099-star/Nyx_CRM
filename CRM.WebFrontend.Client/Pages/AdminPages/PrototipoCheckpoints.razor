<!-- ==================== MODAL: NUEVO ÍTEM ==================== -->
@if (_showNewItemModal)
{
    <div class="proto-modal-overlay">
        <div class="proto-modal-box">
            <h3 style="font-size:1.25rem; font-weight:800; margin:0 0 4px;">Agregar Ítem a la Venta</h3>
