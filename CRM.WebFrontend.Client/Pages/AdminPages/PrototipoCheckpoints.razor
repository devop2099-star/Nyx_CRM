    private void GuardarNuevoCheckpoint()
    {
        var nombre = string.IsNullOrWhiteSpace(_newCpNombre) ? "Checkpoint sin nombre" : _newCpNombre.Trim();
        var bloquea = new List<string>();
        if (_newCpBloqueaComision) bloquea.Add("Comisión");
        if (_newCpBloqueaLiquidacion) bloquea.Add("Liquidación");
        if (_newCpBloqueaAlta) bloquea.Add("Alta del servicio");

        var necesitaGerencia = _newCpBloqueaAvance || !string.IsNullOrEmpty(_newCpRetrocedeA);
        var requisitosCumplidos = _firmaDueno && (!necesitaGerencia || _firmaGerencia);
        var estado = requisitosCumplidos ? "ACTIVO" : "PROPUESTO";

        var newId = _catalog.Any() ? _catalog.Max(c => c.Id) + 1 : 1;
        _catalog.Add(new CheckpointCatalogItem
        {
            Id = newId,
            Nombre = nombre,
            Aplica = _newCpAplica,
            Etapa = _newCpEtapa,
            Origen = _newCpOrigen,
            Alcance = _newCpAlcance,
            Bloquea = bloquea,
            BloqueaAvance = _newCpBloqueaAvance,
            RetrocedeA = string.IsNullOrEmpty(_newCpRetrocedeA) ? null : _newCpRetrocedeA,
            Dueno = _newCpDueno,
            Pasos = new List<string>(_newCpPasos),
            Estado = estado
        });

        _showNewCheckpointModal = false;
        _newCpNombre = string.Empty;
        _newCpPasos.Clear();
        Snackbar.Add(estado == "ACTIVO" ? "Checkpoint guardado y activo." : "Checkpoint guardado como PROPUESTO (falta firma).", Severity.Info);
    }

    private void CrearNuevaVenta()
