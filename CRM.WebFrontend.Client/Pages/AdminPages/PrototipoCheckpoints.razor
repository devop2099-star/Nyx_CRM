    private void ResolverCheckpoint(int idx, string nuevoEstado)
    {
        var v = CurrentVenta;
        var cp = v.Checkpoints[idx];
        var def = _catalog.FirstOrDefault(c => c.Id == cp.CatalogId);
        if (def == null) return;

        cp.Estado = nuevoEstado;
        v.DayCounter++;
        v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"Checkpoint <b>{def.Nombre}</b> marcado {nuevoEstado}" });

        if (nuevoEstado == "KO")
        {
            // Retroceso real
            if (!string.IsNullOrEmpty(def.RetrocedeA))
            {
                var targetIdx = Array.IndexOf(STAGES, def.RetrocedeA);
                if (targetIdx >= 0 && targetIdx < v.StageIdx)
                {
                    var anterior = STAGES[v.StageIdx];
                    v.StageIdx = targetIdx;
                    v.FechasPorEtapa[def.RetrocedeA] = v.DayCounter;
                    v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"⏪ <b>RETROCESO REAL</b>: checkpoint <b>{def.Nombre}</b> hizo retroceder la venta de <b>{anterior}</b> a <b>{def.RetrocedeA}</b>" });
                }
            }

            // Disparo encadenado
            var encadenados = _catalog.Where(c => c.Estado == "ACTIVO" && c.DisparaSiKoDe == def.Id).ToList();
            foreach (var enc in encadenados)
            {
                if (!v.Checkpoints.Any(c => c.CatalogId == enc.Id && c.Estado == "PENDIENTE"))
                {
                    v.DayCounter++;
                    v.Checkpoints.Add(new CheckpointInstanceItem
                    {
                        CatalogId = enc.Id,
                        Estado = "PENDIENTE",
                        FechaApertura = v.DayCounter,
                        PasosCompletados = enc.Pasos.Select(_ => false).ToList()
                    });
                    v.Historial.Add(new SaleHistoryEventUiModel { Dia = v.DayCounter, Detalle = $"🔗 Disparo encadenado: KO en <b>{def.Nombre}</b> abrió automáticamente <b>{enc.Nombre}</b>" });
                }
            }
        }

        Snackbar.Add(nuevoEstado == "SUBSANADO" ? "Checkpoint subsanado." : "Checkpoint marcado como KO.", nuevoEstado == "SUBSANADO" ? Severity.Success : Severity.Error);
    }

    private void ReabrirCheckpoint(int idx)
