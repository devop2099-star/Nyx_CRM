@page "/prototipo/checkpoints"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ADMIN_CRM,SUPERVISOR,BACKOFFICE,ASESOR,COORDINADOR")]
@using MudBlazor
@using CRM.WebFrontend.Client.Models
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Prototipo — Modelo de Checkpoints V2</PageTitle>

<style>
    :root {
        --proto-navy: #090C9B;
        --proto-navy-dim: #1E2761;
        --proto-ink: #171B3D;
        --proto-ink-muted: #5B5F82;
        --proto-paper: #F6F5F0;
        --proto-paper2: #FFFFFF;
        --proto-line: #E4E2DA;
        --proto-gold: #D9A441;
        --proto-gold-dim: #B98B36;
        --proto-green: #1E7A4C;
        --proto-green-bg: #E7F3EC;
        --proto-red: #B00020;
        --proto-red-bg: #FBEAE8;
        --proto-amber: #B8862E;
        --proto-amber-bg: #FBF2DF;
        --proto-violet: #4C56A8;
        --proto-violet-bg: #EBEDFA;
    }

    .proto-app {
        max-width: 1240px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
        color: var(--proto-ink);
    }

    .proto-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 14px;
        background: #fff;
        border-radius: 16px;
        padding: 18px 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        border: 1px solid var(--proto-line);
    }

    .proto-brand {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .proto-mark {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--proto-navy), #003B5C);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 800;
        font-size: 1.25rem;
        box-shadow: 0 4px 12px rgba(9,12,155,0.25);
    }

    .proto-tabs {
        display: flex;
        gap: 6px;
        background: var(--proto-paper);
        border: 1px solid var(--proto-line);
        border-radius: 12px;
        padding: 4px;
    }

    .proto-tab-btn {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--proto-ink-muted);
        background: none;
        border: none;
        padding: 8px 18px;
        border-radius: 9px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .proto-tab-btn.active {
        background: var(--proto-navy);
        color: #fff;
        box-shadow: 0 2px 8px rgba(9,12,155,0.25);
    }

    .proto-card {
        background: #fff;
        border: 1px solid var(--proto-line);
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 18px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    }

    .proto-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .proto-card-head h2 {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
        color: var(--proto-ink);
    }

    .proto-card-head p {
        font-size: 0.8rem;
        color: var(--proto-ink-muted);
        margin: 4px 0 0;
    }

    .proto-btn {
        font-size: 0.825rem;
        font-weight: 700;
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.18s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .proto-btn-primary { background: var(--proto-navy); color: #fff; }
    .proto-btn-primary:hover { background: #003B5C; transform: translateY(-1px); }
    .proto-btn-ghost { background: transparent; border: 1px solid var(--proto-line); color: var(--proto-ink); }
    .proto-btn-ghost:hover { background: var(--proto-paper); }
    .proto-btn-sm { padding: 5px 11px; font-size: 0.75rem; }
    .proto-btn-green { background: var(--proto-green-bg); color: var(--proto-green); border: 1px solid rgba(30,122,76,0.3); }
    .proto-btn-green:hover { background: #d3ecd9; }
    .proto-btn-red { background: var(--proto-red-bg); color: var(--proto-red); border: 1px solid rgba(176,0,32,0.3); }
    .proto-btn-red:hover { background: #fadbd8; }

    /* Pill tags */
    .proto-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: monospace;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 14px;
        white-space: nowrap;
    }

    .proto-pill-green { background: var(--proto-green-bg); color: var(--proto-green); }
    .proto-pill-red { background: var(--proto-red-bg); color: var(--proto-red); }
    .proto-pill-amber { background: var(--proto-amber-bg); color: var(--proto-amber); }
    .proto-pill-violet { background: var(--proto-violet-bg); color: var(--proto-violet); }
    .proto-pill-navy { background: var(--proto-navy); color: #fff; }
    .proto-pill-outline { background: transparent; border: 1px solid var(--proto-line); color: var(--proto-ink-muted); }

    .tag-list { display: flex; gap: 5px; flex-wrap: wrap; }

    /* Tables */
    .proto-table { width: 100%; border-collapse: collapse; font-size: 0.825rem; }
    .proto-table th { text-align: left; font-family: monospace; font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--proto-ink-muted); padding: 9px 10px; border-bottom: 2px solid var(--proto-line); }
    .proto-table td { padding: 11px 10px; border-bottom: 1px solid var(--proto-line); vertical-align: middle; }
    .proto-table tr:last-child td { border-bottom: none; }

    /* Stage Strip (10 Etapas) */
    .stage-strip {
        display: flex;
        align-items: center;
        overflow-x: auto;
        padding: 16px 0 10px;
        margin-bottom: 10px;
    }

    .stage-dot-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 86px;
        position: relative;
        flex: 1;
    }

    .stage-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #D8D6CC;
        z-index: 2;
        transition: all 0.25s ease;
    }

    .stage-dot.done { background: var(--proto-gold-dim); }
    .stage-dot.current { background: var(--proto-gold); box-shadow: 0 0 0 5px rgba(217,164,65,0.28); }
    .stage-line { position: absolute; top: 6px; left: 50%; width: 100%; height: 2px; background: var(--proto-line); z-index: 1; }
    .stage-dot-wrap:last-child .stage-line { display: none; }
    .stage-label { font-size: 0.72rem; margin-top: 8px; text-align: center; color: var(--proto-ink-muted); line-height: 1.2; font-weight: 500; }
    .stage-label.current { color: var(--proto-ink); font-weight: 800; }

    /* Venta chips */
    .venta-select { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
    .venta-chip { padding: 8px 16px; border-radius: 10px; border: 1.5px solid var(--proto-line); background: #fff; cursor: pointer; font-size: 0.825rem; font-weight: 700; transition: all 0.15s ease; }
    .venta-chip.active { border-color: var(--proto-navy); background: var(--proto-navy); color: #fff; }

    /* Checklist de pasos */
    .pasos-checklist { background: var(--proto-paper); border-radius: 10px; padding: 10px 14px; margin: 6px 0; border: 1px solid var(--proto-line); }
    .pasos-checklist .paso-row { display: flex; align-items: center; gap: 8px; padding: 5px 0; font-size: 0.8rem; }
    .pasos-checklist .paso-row.done { color: var(--proto-ink-muted); text-decoration: line-through; }
    .pasos-progress { font-family: monospace; font-size: 0.72rem; color: var(--proto-ink-muted); margin-bottom: 6px; font-weight: 700; }

    /* Banners */
    .proto-banner { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 10px; font-size: 0.825rem; font-weight: 700; margin-top: 14px; }
    .proto-banner-red { background: var(--proto-red-bg); color: var(--proto-red); border: 1px solid rgba(176,0,32,0.2); }
    .proto-banner-green { background: var(--proto-green-bg); color: var(--proto-green); border: 1px solid rgba(30,122,76,0.2); }
    .proto-banner-amber { background: var(--proto-amber-bg); color: var(--proto-amber); border: 1px solid rgba(184,134,46,0.2); }

    /* Modals */
    .proto-modal-overlay { position: fixed; inset: 0; background: rgba(9,12,45,0.6); z-index: 1050; display: flex; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(4px); }
    .proto-modal-box { background: #fff; border-radius: 18px; padding: 28px; width: 100%; max-width: 600px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-height: 90vh; overflow-y: auto; }
    .proto-field { margin-bottom: 14px; }
    .proto-field label { display: block; font-family: monospace; font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--proto-ink-muted); margin-bottom: 5px; font-weight: 700; }
    .proto-field input[type=text], .proto-field select { width: 100%; padding: 8px 12px; border: 1px solid var(--proto-line); border-radius: 8px; font-size: 0.85rem; background: var(--proto-paper); }
    .proto-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .check-group { display: flex; gap: 14px; flex-wrap: wrap; }
    .check-group label { display: flex; align-items: center; gap: 6px; font-size: 0.825rem; font-weight: 600; color: var(--proto-ink); }
    .approval-box { background: var(--proto-paper); border: 1px dashed var(--proto-line); border-radius: 10px; padding: 14px 16px; margin-top: 6px; }

    .history-item { display: flex; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--proto-line); font-size: 0.8rem; }
    .history-item:last-child { border-bottom: none; }
    .history-day { font-family: monospace; font-size: 0.72rem; color: var(--proto-gold-dim); min-width: 52px; font-weight: 800; }
</style>

<div class="proto-app">
    <!-- Header -->
    <div class="proto-header">
        <div class="proto-brand">
            <div class="proto-mark">G</div>
            <div>
                <h1 style="font-size:1.25rem; font-weight:800; margin:0;">GSI — Prototipo Modelo de Checkpoints V2</h1>
                <span style="font-family:monospace; font-size:0.72rem; color:var(--proto-ink-muted);">ARQUITECTURA DE GOBERNANZA, 10 ETAPAS Y CONTABILIDAD DUAL</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="proto-tabs">
                <button class="proto-tab-btn @(_activeTab == "catalogo" ? "active" : "")" @onclick='() => _activeTab = "catalogo"'>
                    <i class="bi bi-gear-wide-connected me-1"></i> Catálogo (Capa 1)
                </button>
                <button class="proto-tab-btn @(_activeTab == "venta" ? "active" : "")" @onclick='() => _activeTab = "venta"'>
                    <i class="bi bi-file-earmark-text-fill me-1"></i> Ficha de Venta (Capa 2)
                </button>
            </div>
            <button class="proto-btn proto-btn-ghost proto-btn-sm" @onclick='() => Nav.NavigateTo("/supervisor")'>
                <i class="bi bi-arrow-left"></i> Volver
            </button>
        </div>
    </div>

    @if (_activeTab == "catalogo")
    {
        <!-- TAB 1: CATÁLOGO DE CHECKPOINTS (CAPA 1) -->
        <div class="proto-card">
            <div class="proto-card-head">
                <div>
                    <h2>Catálogo de Checkpoints — Capa 1 (Gobernado)</h2>
                    <p>Configuración versionada maestra. Cada fila nueva requiere Triple Firma antes de quedar activa.</p>
                </div>
                <button class="proto-btn proto-btn-primary" @onclick="() => _showNewCheckpointModal = true">
                    <i class="bi bi-plus-lg"></i> Nuevo Checkpoint
                </button>
            </div>

            @if (_catalog.Any(c => c.Estado != "ACTIVO"))
            {
                <div class="proto-banner proto-banner-amber mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Hay checkpoints <b>PROPUESTOS</b> en el catálogo. Mientras no reúnan las firmas requeridas, no se auto-instanciarán en las ventas. Usa el botón "Aprobar ahora" para simular su activación.</span>
                </div>
            }

            <table class="proto-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Aplica a</th>
                        <th>Etapa Disparo</th>
                        <th>Origen</th>
                        <th>Alcance</th>
                        <th>Bloquea</th>
                        <th>Dueño</th>
                        <th>Aprobación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _catalog)
                    {
                        <tr>
                            <td>
                                <b>@c.Nombre</b>
                                @if (c.Pasos.Any())
                                {
                                    <span class="proto-pill proto-pill-outline ms-1">@c.Pasos.Count pasos</span>
                                }
                            </td>
                            <td>@c.Aplica</td>
                            <td><span style="font-family:monospace; font-size:0.75rem;">@c.Etapa</span></td>
                            <td><span class="proto-pill @(c.Origen == "INTERNO" ? "proto-pill-violet" : "proto-pill-amber")">@c.Origen</span></td>
                            <td><span style="font-family:monospace; font-size:0.75rem;">@c.Alcance</span></td>
                            <td>
                                <div class="tag-list">
                                    @foreach (var b in c.Bloquea)
                                    {
                                        <span class="proto-pill proto-pill-red">@b</span>
                                    }
                                    @if (c.BloqueaAvance)
                                    {
                                        <span class="proto-pill proto-pill-amber">🔒 bloquea avance</span>
                                    }
                                    @if (!string.IsNullOrEmpty(c.RetrocedeA))
                                    {
                                        <span class="proto-pill proto-pill-red">⏪ retrocede a @c.RetrocedeA</span>
                                    }
                                    @if (c.DisparaSiKoDe.HasValue)
                                    {
                                        <span class="proto-pill proto-pill-violet">🔗 KO de #@c.DisparaSiKoDe</span>
                                    }
                                </div>
                            </td>
                            <td><span class="proto-pill proto-pill-violet">@c.Dueno</span></td>
                            <td>
                                @if (c.Estado == "ACTIVO")
                                {
                                    <span class="proto-pill proto-pill-green"><i class="bi bi-check-circle-fill me-1"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="proto-pill proto-pill-amber">Propuesto</span>
                                    <button class="proto-btn proto-btn-primary proto-btn-sm ms-2" @onclick="() => AprobarCheckpoint(c.Id)">
                                        Aprobar ahora
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- TAB 2: FICHA DE VENTA (CAPA 2) -->
        <div class="venta-select">
            @foreach (var v in _ventas.Values)
            {
                <div class="venta-chip @(v.Id == _currentVentaId ? "active" : "")" @onclick="() => _currentVentaId = v.Id">
                    @v.Label
                </div>
            }
            <button class="proto-btn proto-btn-ghost proto-btn-sm ms-auto" @onclick="() => _showNewVentaModal = true">
                <i class="bi bi-plus-circle"></i> Nueva venta desde cero
            </button>
        </div>

        <!-- Tarjeta 1: Lifecycle 10 Etapas -->
        <div class="proto-card">
            <div class="proto-card-head">
                <div>
                    <h2>Venta @CurrentVenta.Label</h2>
                    <p>Campaña: <b>@CurrentVenta.Campana</b> · Día simulado: <b>@CurrentVenta.DayCounter</b></p>
                </div>
                <span class="proto-pill proto-pill-navy" style="font-size:0.85rem; padding:6px 14px;">
                    Etapa Actual: @STAGES[CurrentVenta.StageIdx]
                </span>
            </div>

            <!-- Tira de 10 Etapas -->
            <div class="stage-strip">
                @for (int i = 0; i < STAGES.Length; i++)
                {
                    var idx = i;
                    <div class="stage-dot-wrap">
                        <div class="stage-line"></div>
                        <div class="stage-dot @(idx < CurrentVenta.StageIdx ? "done" : "") @(idx == CurrentVenta.StageIdx ? "current" : "")"></div>
                        <div class="stage-label @(idx == CurrentVenta.StageIdx ? "current" : "")">@STAGES[idx]</div>
                    </div>
                }
            </div>

            <!-- Timeline de permanencia -->
            <div style="font-family:monospace; font-size:0.75rem; color:var(--proto-ink-muted); margin-top:6px;">
                @string.Join("  ·  ", CurrentVenta.FechasPorEtapa.Select(kv => $"{kv.Key}: día {kv.Value}"))
            </div>

            <div class="mt-3">
                <button class="proto-btn proto-btn-ghost proto-btn-sm" @onclick="AvanzarEtapa">
                    <i class="bi bi-arrow-right-circle"></i> → Avanzar a la siguiente etapa
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(_bloqueoAvanceWarning))
            {
                <div class="proto-banner proto-banner-amber mt-2">
                    <i class="bi bi-lock-fill"></i> @_bloqueoAvanceWarning
                </div>
            }
        </div>

        <!-- Tarjeta 2: Ítems de la Venta (Ancla y Núcleo) -->
        <div class="proto-card">
            <div class="proto-card-head">
                <div>
                    <h2>Ítems de la Venta</h2>
                    <p>Cada ítem posee su propio estado operativo, bandera de ancla y núcleo comercial.</p>
                </div>
                <button class="proto-btn proto-btn-ghost proto-btn-sm" @onclick="() => _showNewItemModal = true">
                    <i class="bi bi-plus-lg"></i> Agregar Ítem
                </button>
            </div>

            <table class="proto-table">
                <thead>
                    <tr>
                        <th>Ítem</th>
                        <th>es_ancla_etapa</th>
                        <th>es_nucleo_comision</th>
                        <th>Estado</th>
                        <th>Activado</th>
                        <th>Desconectado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < CurrentVenta.Items.Count; i++)
                    {
                        var itIdx = i;
                        var it = CurrentVenta.Items[itIdx];
                        <tr>
                            <td><b>@it.Nombre</b></td>
                            <td>
                                <span class="proto-pill @(it.Ancla ? "proto-pill-green" : "proto-pill-outline")">
                                    @(it.Ancla ? "SÍ (Ancla)" : "no")
                                </span>
                            </td>
                            <td>
                                <span class="proto-pill @(it.Nucleo ? "proto-pill-violet" : "proto-pill-outline")">
                                    @(it.Nucleo ? "SÍ (Núcleo)" : "no")
                                </span>
                            </td>
                            <td>
                                <span class="proto-pill @(it.Estado == "ACTIVO" ? "proto-pill-green" : it.Estado == "PENDIENTE" ? "proto-pill-amber" : "proto-pill-red")">
                                    @it.Estado
                                </span>
                            </td>
                            <td style="font-family:monospace;">@(it.FechaActivacion.HasValue ? $"Día {it.FechaActivacion}" : "—")</td>
                            <td style="font-family:monospace;">@(it.FechaDesconexion.HasValue ? $"Día {it.FechaDesconexion}" + (it.FechaRecuperacion.HasValue ? $" → recup. día {it.FechaRecuperacion}" : "") : "—")</td>
                            <td>
                                @if (it.Estado == "PENDIENTE")
                                {
                                    <button class="proto-btn proto-btn-green proto-btn-sm" @onclick="() => ActivarItem(itIdx)">Marcar activo</button>
                                }
                                else if (it.Estado == "ACTIVO")
                                {
                                    <button class="proto-btn proto-btn-red proto-btn-sm" @onclick="() => DesconectarItem(itIdx)">Marcar desconectado / impago</button>
                                }
                                else if (it.Estado == "DESCONECTADO")
                                {
                                    <button class="proto-btn proto-btn-green proto-btn-sm" @onclick="() => RecuperarItem(itIdx)">🔄 Recuperar (reconectó)</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Tarjeta 3: Resumen Contable Dual (2 Libros) -->
        <div class="proto-card">
            <div class="proto-card-head">
                <div>
                    <h2>💳 Resumen de Pagos — Dos Libros Contables</h2>
                    <p>Libro 1: Liquidación Proveedor ➔ GSI | Libro 2: Comisión GSI ➔ Asesor Comercial.</p>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap mb-2">
                <button class="proto-btn proto-btn-primary proto-btn-sm" @onclick="SimularCorteLiquidacion">
                    💰 Correr corte de liquidación (Proveedor ➔ GSI)
                </button>
                <button class="proto-btn proto-btn-primary proto-btn-sm" @onclick="SimularPagoComercial">
                    💵 Correr corte de pago a comercial (GSI ➔ Asesor)
                </button>
            </div>
            <p style="font-size:0.75rem; color:var(--proto-ink-muted); margin-bottom:12px;">
                ℹ Los cortes son eventos de calendario independientes del avance de etapa (ej. día 5 de mes), no compuertas que detienen el aprovisionamiento.
            </p>

            <table class="proto-table">
                <thead>
                    <tr>
                        <th>Ítem</th>
                        <th>Valor Liquidación</th>
                        <th>Liquidado el</th>
                        <th>Comisión Asesor</th>
                        <th>Pagado el</th>
                        <th>Estado del Pago</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in CurrentVenta.Items)
                    {
                        var (txt, cls) = GetEstadoPago(it);
                        <tr>
                            <td><b>@it.Nombre</b></td>
                            <td style="font-family:monospace;">S/. @it.ValorLiquidacion.ToString("N2")</td>
                            <td style="font-family:monospace;">@(it.FechaLiquidado.HasValue ? $"Día {it.FechaLiquidado}" : "—")</td>
                            <td style="font-family:monospace;">S/. @it.ComisionComercial.ToString("N2")</td>
                            <td style="font-family:monospace;">@(it.FechaPagoComercial.HasValue ? $"Día {it.FechaPagoComercial}" : "—")</td>
                            <td><span class="proto-pill @cls">@txt</span></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex gap-4 mt-3 pt-2 border-top flex-wrap" style="font-family:monospace; font-size:0.8rem;">
                <span>Total liquidado a GSI: <b style="color:var(--proto-green);">S/. @TotalLiquidado.ToString("N2")</b></span>
                <span>Total pagado a comerciales: <b style="color:var(--proto-navy);">S/. @TotalPagado.ToString("N2")</b></span>
                <span>Total descomisión / descontado: <b style="color:var(--proto-red);">S/. @TotalDescontado.ToString("N2")</b></span>
            </div>
        </div>

        <!-- Tarjeta 4: Checkpoints Activos en la Venta (Capa 2) -->
        <div class="proto-card">
            <div class="proto-card-head">
                <div>
                    <h2>Checkpoints Activos — Capa 2 (Instancia)</h2>
                    <p>Generados automáticamente al ingresar a su etapa de disparo, por KO encadenado o apertura manual.</p>
                </div>
            </div>

            @if (!CurrentVenta.Checkpoints.Any())
            {
                <div style="text-align:center; padding:24px; color:var(--proto-ink-muted); font-size:0.85rem;">
                    Sin checkpoints activos para esta venta.
                </div>
            }
            else
            {
                <table class="proto-table">
                    <thead>
                        <tr>
                            <th>Checkpoint</th>
                            <th>Alcance</th>
                            <th>Abierto en</th>
                            <th>Estado</th>
                            <th>Bloquea</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < CurrentVenta.Checkpoints.Count; i++)
                        {
                            var cpIdx = i;
                            var cp = CurrentVenta.Checkpoints[cpIdx];
                            var def = _catalog.FirstOrDefault(c => c.Id == cp.CatalogId);
                            if (def == null) continue;

                            var completados = cp.PasosCompletados.Count(x => x);

                            <tr>
                                <td>
                                    <b>@def.Nombre</b>
                                    @if (def.Pasos.Any())
                                    {
                                        <span class="proto-pill proto-pill-outline ms-1">@completados/@def.Pasos.Count pasos</span>
                                    }
                                </td>
                                <td><span style="font-family:monospace;">@def.Alcance</span></td>
                                <td>
                                    <span style="font-family:monospace;">
                                        @(cp.Estado == "PROGRAMADO" ? $"Programado día {cp.FechaProgramada}" : $"Día {cp.FechaApertura}")
                                    </span>
                                    @if (cp.Retro)
                                    {
                                        <span class="proto-pill proto-pill-amber ms-1">retroactivo</span>
                                    }
                                </td>
                                <td>
                                    <span class="proto-pill @(cp.Estado == "SUBSANADO" ? "proto-pill-green" : cp.Estado == "PENDIENTE" ? "proto-pill-amber" : "proto-pill-red")">
                                        @cp.Estado
                                    </span>
                                </td>
                                <td>
                                    <div class="tag-list">
                                        @foreach (var b in def.Bloquea)
                                        {
                                            <span class="proto-pill proto-pill-red">@b</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (cp.Estado == "PENDIENTE")
                                    {
                                        @if (def.Origen == "PROVEEDOR")
                                        {
                                            <span class="proto-pill proto-pill-amber me-1">esperando proveedor</span>
                                            <button class="proto-btn proto-btn-ghost proto-btn-sm" @onclick='() => ResolverCheckpoint(cpIdx, "SUBSANADO")'>
                                                Simular confirmación
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="proto-btn proto-btn-green proto-btn-sm me-1" @onclick='() => ResolverCheckpoint(cpIdx, "SUBSANADO")'>
                                                Marcar subsanado
                                            </button>
                                            <button class="proto-btn proto-btn-red proto-btn-sm" @onclick='() => ResolverCheckpoint(cpIdx, "KO")'>
                                                Marcar KO
                                            </button>
                                        }
                                    }
                                    else if (cp.Estado == "KO")
                                    {
                                        <button class="proto-btn proto-btn-ghost proto-btn-sm" @onclick="() => ReabrirCheckpoint(cpIdx)">
                                            🔄 Asesor corrigió
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-family:monospace; font-size:0.75rem; color:var(--proto-green);">✓ resuelto</span>
                                    }
                                </td>
                            </tr>

                            @if (def.Pasos.Any() && cp.Estado == "PENDIENTE")
                            {
                                <tr>
                                    <td colspan="6" style="padding-top:0;">
                                        <div class="pasos-checklist">
                                            <div class="pasos-progress">Checklist de sub-pasos (Capa 2b): @completados / @def.Pasos.Count completados</div>
                                            @for (int pIdx = 0; pIdx < def.Pasos.Count; pIdx++)
                                            {
                                                var localPIdx = pIdx;
                                                var isDone = localPIdx < cp.PasosCompletados.Count && cp.PasosCompletados[localPIdx];
                                                <div class="paso-row @(isDone ? "done" : "")">
                                                    <input type="checkbox" checked="@isDone" @onchange="() => TogglePaso(cpIdx, localPIdx)" />
                                                    <span>@(localPIdx + 1). @def.Pasos[localPIdx]</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- Banner dinámico de bloqueo -->
            @{
                var pendingBlocks = GetPendingBlocks();
                var riesgos = GetRiesgos();
            }

            @if (pendingBlocks.Any())
            {
                <div class="proto-banner proto-banner-red">
                    <i class="bi bi-x-octagon-fill"></i>
                    <span>⊘ Procesos derivados retenidos: <b>@string.Join(", ", pendingBlocks)</b> — El aprovisionamiento con el proveedor continúa con normalidad.</span>
                </div>
            }
            else if (riesgos.Any())
            {
                <div class="proto-banner proto-banner-amber">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>⚠ Riesgo operativo detectado: @string.Join(", ", riesgos) — Requiere seguimiento, no retiene comisiones.</span>
                </div>
            }
            else if (CurrentVenta.Checkpoints.Any())
            {
                <div class="proto-banner proto-banner-green">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>✓ Todos los checkpoints resueltos — ningún proceso derivado retenido.</span>
                </div>
            }

            <!-- Adjuntar Manualmente -->
            <div class="d-flex gap-2 align-items-center mt-3 pt-2 border-top flex-wrap">
                <select class="form-select form-select-sm" style="max-width:320px;" @bind="_selectedCheckpointToAttach">
                    @foreach (var c in _catalog.Where(c => c.Estado == "ACTIVO" && !CurrentVenta.Checkpoints.Any(cp => cp.CatalogId == c.Id)))
                    {
                        <option value="@c.Id">@c.Nombre (dispara en @c.Etapa)</option>
                    }
                </select>
                <button class="proto-btn proto-btn-ghost proto-btn-sm" @onclick="AdjuntarCheckpointManual">
                    <i class="bi bi-paperclip"></i> + Adjuntar checkpoint a esta venta
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_retroWarning))
            {
                <div class="proto-banner proto-banner-amber mt-2">
                    <i class="bi bi-info-circle-fill"></i> @_retroWarning
                </div>
            }
        </div>

        <!-- Tarjeta 5: Historial de la Venta -->
        <div class="proto-card">
            <div class="proto-card-head">
                <div>
                    <h2>Historial y Auditoría de la Venta</h2>
                    <p>Registro cronológico de eventos con día simulado.</p>
                </div>
            </div>
            <div>
                @foreach (var h in CurrentVenta.Historial)
                {
                    <div class="history-item">
                        <div class="history-day">Día @h.Dia</div>
                        <div>@((MarkupString)h.Detalle)</div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ==================== MODAL: NUEVO CHECKPOINT (CAPA 1) ==================== -->
@if (_showNewCheckpointModal)
{
    <div class="proto-modal-overlay">
        <div class="proto-modal-box">
            <h3 style="font-size:1.25rem; font-weight:800; margin:0 0 4px;">Nuevo Checkpoint — Capa 1</h3>
            <p style="font-size:0.75rem; color:var(--proto-ink-muted); margin-bottom:18px;">
                Nace en estado <b>PROPUESTO</b> hasta reunir la Triple Firma de gobernanza.
            </p>

            <div class="proto-field">
                <label>Nombre del Checkpoint</label>
                <input type="text" placeholder='Ej. "Verificación de audio y sustento"' @bind="_newCpNombre" />
            </div>

            <div class="proto-field-row">
                <div class="proto-field">
                    <label>Aplica a (Campaña)</label>
                    <select @bind="_newCpAplica">
                        <option>Alarmas</option>
                        <option>Telecom — Vodafone</option>
                        <option>Telecom — Yoigo</option>
                        <option>Telecom — MásMóvil</option>
                        <option>Toda campaña nueva</option>
                    </select>
                </div>
                <div class="proto-field">
                    <label>Etapa Disparo</label>
                    <select @bind="_newCpEtapa">
                        @foreach (var stage in STAGES)
                        {
                            <option value="@stage">@stage</option>
                        }
                    </select>
                </div>
            </div>

            <div class="proto-field-row">
                <div class="proto-field">
                    <label>Origen</label>
                    <div class="d-flex gap-3 mt-1">
                        <label><input type="radio" name="cp-origen" value="INTERNO" checked="@(_newCpOrigen == "INTERNO")" @onchange='() => SetOrigen("INTERNO")' /> Interno</label>
                        <label><input type="radio" name="cp-origen" value="PROVEEDOR" checked="@(_newCpOrigen == "PROVEEDOR")" @onchange='() => SetOrigen("PROVEEDOR")' /> Proveedor</label>
                    </div>
                </div>
                <div class="proto-field">
                    <label>Alcance</label>
                    <div class="d-flex gap-3 mt-1">
                        <label><input type="radio" name="cp-alcance" value="Venta" checked="@(_newCpAlcance == "Venta")" @onchange='() => _newCpAlcance = "Venta"' /> Venta</label>
                        <label><input type="radio" name="cp-alcance" value="Ítem" checked="@(_newCpAlcance == "Ítem")" @onchange='() => _newCpAlcance = "Ítem"' /> Ítem</label>
                    </div>
                </div>
            </div>

            <div class="proto-field">
                <label>Bloquea procesos derivados</label>
                <div class="check-group">
                    <label><input type="checkbox" @bind="_newCpBloqueaComision" /> Comisión</label>
                    <label><input type="checkbox" @bind="_newCpBloqueaLiquidacion" /> Liquidación</label>
                    <label><input type="checkbox" @bind="_newCpBloqueaAlta" /> Alta del servicio</label>
                </div>
            </div>

            <div class="proto-field">
                <label>Excepción — Bloquea avance de etapa</label>
                <div class="check-group">
                    <label><input type="checkbox" @bind="_newCpBloqueaAvance" /> Sí, impide avanzar de etapa mientras esté pendiente</label>
                </div>
                <small style="color:var(--proto-ink-muted); font-size:0.72rem;">⚠ Se marca automáticamente si el origen es Proveedor.</small>
            </div>

            <div class="proto-field">
                <label>Excepción — Si sale KO, retrocede la venta</label>
                <select @bind="_newCpRetrocedeA">
                    <option value="">No retrocede (comportamiento estándar)</option>
                    @foreach (var stage in STAGES.Take(9))
                    {
                        <option value="@stage">@stage</option>
                    }
                </select>
            </div>

            <div class="proto-field">
                <label>Sub-pasos internos (Capa 1b - Checklist opcional)</label>
                <div class="d-flex gap-2 mb-2">
                    <input type="text" placeholder="Ej. Extraer audio de grabación" @bind="_tempPasoText" style="flex:1;" />
                    <button type="button" class="proto-btn proto-btn-ghost proto-btn-sm" @onclick="AddPaso">+ Agregar</button>
                </div>
                <div class="tag-list">
                    @for (int i = 0; i < _newCpPasos.Count; i++)
                    {
                        var pIdx = i;
                        <span class="proto-pill proto-pill-violet">
                            @(pIdx + 1). @_newCpPasos[pIdx]
                            <button type="button" style="background:none; border:none; color:inherit; font-weight:800; margin-left:4px; cursor:pointer;" @onclick="() => _newCpPasos.RemoveAt(pIdx)">×</button>
                        </span>
                    }
                </div>
            </div>

            <div class="proto-field">
                <label>Departamento Dueño del Proceso</label>
                <select @bind="_newCpDueno">
                    <option>Finanzas</option>
                    <option>Operaciones</option>
                    <option>Backoffice</option>
                    <option>Calidad</option>
                    <option>Postventa</option>
                    <option>Logística</option>
                </select>
            </div>

            <div class="proto-field">
                <label>Gobernanza y Aprobación Requerida</label>
                <div class="approval-box">
                    <div class="check-group">
                        <label><input type="checkbox" checked disabled /> Data & Analytics (estructura - siempre)</label>
                        <label><input type="checkbox" @bind="_firmaDueno" /> @_newCpDueno (dueño de proceso)</label>
                        <label>
                            <input type="checkbox" @bind="_firmaGerencia" /> Gerencia
                            <span style="color:var(--proto-ink-muted); font-size:0.72rem;">@((_newCpBloqueaAvance || !string.IsNullOrEmpty(_newCpRetrocedeA)) ? "(obligatoria por excepción)" : "(opcional)")</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="proto-btn proto-btn-ghost" @onclick="() => _showNewCheckpointModal = false">Cancelar</button>
                <button class="proto-btn proto-btn-primary" @onclick="GuardarNuevoCheckpoint">Guardar Checkpoint</button>
            </div>
        </div>
    </div>
}

