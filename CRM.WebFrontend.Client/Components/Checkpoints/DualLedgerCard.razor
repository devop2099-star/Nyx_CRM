@using CRM.WebFrontend.Client.Models

<div class="proto-card">
    <div class="proto-card-head">
        <div>
            <h2>💳 Resumen de Pagos — Dos Libros Contables</h2>
            <p>Libro 1: Liquidación Proveedor ➔ GSI | Libro 2: Comisión GSI ➔ Asesor Comercial.</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap mb-2">
        <button class="proto-btn proto-btn-primary proto-btn-sm" @onclick="OnSimularLiquidacion">
            💰 Correr corte de liquidación (Proveedor ➔ GSI)
        </button>
        <button class="proto-btn proto-btn-primary proto-btn-sm" @onclick="OnSimularPagoComercial">
            💵 Correr corte de pago a comercial (GSI ➔ Asesor)
        </button>
    </div>
    <p style="font-size:0.75rem; color:var(--proto-ink-muted); margin-bottom:12px;">
        ℹ Los cortes son eventos de calendario independientes del avance de etapa (ej. día 5 de mes), no compuertas que detienen el aprovisionamiento.
    </p>

    <table class="proto-table">
        <thead>
            <tr>
                <th>Ítem</th>
                <th>Valor Liquidación</th>
                <th>Liquidado el</th>
                <th>Comisión Asesor</th>
                <th>Pagado el</th>
                <th>Estado del Pago</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var it in Items)
            {
                var (txt, cls) = GetEstadoPago(it);
                <tr>
                    <td><b>@it.Nombre</b></td>
                    <td style="font-family:monospace;">S/. @it.ValorLiquidacion.ToString("N2")</td>
                    <td style="font-family:monospace;">@(it.FechaLiquidado.HasValue ? $"Día {it.FechaLiquidado}" : "—")</td>
                    <td style="font-family:monospace;">S/. @it.ComisionComercial.ToString("N2")</td>
                    <td style="font-family:monospace;">@(it.FechaPagoComercial.HasValue ? $"Día {it.FechaPagoComercial}" : "—")</td>
                    <td><span class="proto-pill @cls">@txt</span></td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var totalLiquidado = Items.Where(it => it.FechaLiquidado.HasValue).Sum(it => it.ValorLiquidacion);
        var totalPagado = Items.Where(it => it.FechaPagoComercial.HasValue && !it.FechaDescuentoComercial.HasValue).Sum(it => it.ComisionComercial);
        var totalDescontado = Items.Where(it => it.FechaDescuentoComercial.HasValue).Sum(it => it.ComisionComercial);
    }
    <div class="d-flex gap-4 mt-3 pt-2 border-top flex-wrap" style="font-family:monospace; font-size:0.8rem;">
        <span>Total liquidado a GSI: <b style="color:var(--proto-green);">S/. @totalLiquidado.ToString("N2")</b></span>
        <span>Total pagado a comerciales: <b style="color:var(--proto-navy);">S/. @totalPagado.ToString("N2")</b></span>
        <span>Total descomisión / descontado: <b style="color:var(--proto-red);">S/. @totalDescontado.ToString("N2")</b></span>
    </div>
</div>

@code {
    [Parameter] public List<SaleItemUiModel> Items { get; set; } = new();
    [Parameter] public EventCallback OnSimularLiquidacion { get; set; }
    [Parameter] public EventCallback OnSimularPagoComercial { get; set; }

    private (string, string) GetEstadoPago(SaleItemUiModel it)
    {
        if (it.FechaDescuentoComercial.HasValue) return ("Descontado a asesor", "proto-pill-red");
        if (it.FechaDescuentoProveedor.HasValue && !it.FechaPagoComercial.HasValue) return ("Descontado a GSI — sin pagar a asesor", "proto-pill-red");
        if (it.FechaPagoComercial.HasValue) return ("Pagado al asesor", "proto-pill-green");
        if (it.FechaLiquidado.HasValue) return ("Liquidado a GSI — pendiente de pagar asesor", "proto-pill-amber");
        if (it.Estado == "DESCONECTADO") return ("Desconectado antes de liquidar — no se paga", "proto-pill-outline");
        if (it.Estado == "ACTIVO") return ("Activo — pendiente de liquidar con proveedor", "proto-pill-amber");
        return ("Sin activar", "proto-pill-outline");
    }
}
