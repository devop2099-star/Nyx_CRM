@using CRM.WebFrontend.Client.Models

<div class="proto-card">
    <div class="proto-card-head">
        <div>
            <h2>Ítems de la Venta</h2>
            <p>Cada ítem posee su propio estado operativo, bandera de ancla y núcleo comercial.</p>
        </div>
        <button class="proto-btn proto-btn-ghost proto-btn-sm" @onclick="OnOpenAddItemModal">
            <i class="bi bi-plus-lg"></i> Agregar Ítem
        </button>
    </div>

    <table class="proto-table">
        <thead>
            <tr>
                <th>Ítem</th>
                <th>es_ancla_etapa</th>
                <th>es_nucleo_comision</th>
                <th>Estado</th>
                <th>Activado</th>
                <th>Desconectado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Items.Count; i++)
            {
                var itIdx = i;
                var it = Items[itIdx];
                <tr>
                    <td><b>@it.Nombre</b></td>
                    <td>
                        <span class="proto-pill @(it.Ancla ? "proto-pill-green" : "proto-pill-outline")">
                            @(it.Ancla ? "SÍ (Ancla)" : "no")
                        </span>
                    </td>
                    <td>
                        <span class="proto-pill @(it.Nucleo ? "proto-pill-violet" : "proto-pill-outline")">
                            @(it.Nucleo ? "SÍ (Núcleo)" : "no")
                        </span>
                    </td>
                    <td>
                        <span class="proto-pill @(it.Estado == "ACTIVO" ? "proto-pill-green" : it.Estado == "PENDIENTE" ? "proto-pill-amber" : "proto-pill-red")">
                            @it.Estado
                        </span>
                    </td>
                    <td style="font-family:monospace;">@(it.FechaActivacion.HasValue ? $"Día {it.FechaActivacion}" : "—")</td>
                    <td style="font-family:monospace;">@(it.FechaDesconexion.HasValue ? $"Día {it.FechaDesconexion}" + (it.FechaRecuperacion.HasValue ? $" → recup. día {it.FechaRecuperacion}" : "") : "—")</td>
                    <td>
                        @if (it.Estado == "PENDIENTE")
                        {
                            <button class="proto-btn proto-btn-green proto-btn-sm" @onclick="() => OnActivarItem.InvokeAsync(itIdx)">Marcar activo</button>
                        }
                        else if (it.Estado == "ACTIVO")
                        {
                            <button class="proto-btn proto-btn-red proto-btn-sm" @onclick="() => OnDesconectarItem.InvokeAsync(itIdx)">Marcar desconectado / impago</button>
                        }
                        else if (it.Estado == "DESCONECTADO")
                        {
                            <button class="proto-btn proto-btn-green proto-btn-sm" @onclick="() => OnRecuperarItem.InvokeAsync(itIdx)">🔄 Recuperar (reconectó)</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public List<SaleItemUiModel> Items { get; set; } = new();
    [Parameter] public EventCallback OnOpenAddItemModal { get; set; }
    [Parameter] public EventCallback<int> OnActivarItem { get; set; }
    [Parameter] public EventCallback<int> OnDesconectarItem { get; set; }
    [Parameter] public EventCallback<int> OnRecuperarItem { get; set; }
}
